# 统一换行符策略：仓库内所有文本文件一律使用 LF
# 目的：Windows（日常编辑）与 Ubuntu（编译验收）读写同一份文件时不产生换行符差异
* text=auto eol=lf

# 明确按文本处理的类型
*.md            text eol=lf
*.txt           text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
CMakeLists.txt  text eol=lf
*.cmake         text eol=lf
*.cpp           text eol=lf
*.cc            text eol=lf
*.cxx           text eol=lf
*.hpp           text eol=lf
*.h             text eol=lf
*.sh            text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制文件：禁止换行符转换和文本合并
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.so    binary
*.a     binary
*.o     binary
*.obj   binary
*.pdb   binary
